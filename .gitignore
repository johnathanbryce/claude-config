# ---------------------------------------------------------------------------
# ~/.claude — what NOT to back up.
# Everything here is machine-local runtime state: regenerated by Claude Code on
# any machine, large, or meaningless once moved. Config and hand-written
# customizations are tracked; runtime noise is not.
# ---------------------------------------------------------------------------

# Session + transcript runtime state
sessions/
session-env/
shell-snapshots/
file-history/
ide/

# Diagnostics and metrics
debug/
telemetry/
stats-cache.json
mcp-needs-auth-cache.json

# Local backups / snapshots
backups/
*.bak-*

# Plugins are installed from their own sources, not vendored here
plugins/

# Machine-local bookkeeping
.last-cleanup
pull-brief/state/
.claude/

# ---------------------------------------------------------------------------
# projects/ — per-project session transcripts (large, machine-local) are
# excluded, but the hand-written memory notes inside them are KEPT.
#
# Order matters: a directory can never be re-included once its parent is
# excluded, so each level is excluded and its directories re-admitted in turn.
# ---------------------------------------------------------------------------
projects/*
!projects/*/
projects/*/*
!projects/*/memory/
projects/
settings.json
.DS_Store
pull-brief/
